# Copy this file to .env and fill in real values. Never commit .env to git.

# Port the API server runs on
PORT=5001

# The email address that will RECEIVE contact/appointment requests
BUSINESS_EMAIL=Coloradotechrescue@gmail.com

# Gmail account used to SEND the notification email (can be the same address above)
# You must create a 16-character Gmail "App Password" - regular Gmail passwords will NOT work.
# Guide: https://support.google.com/accounts/answer/185833
GMAIL_USER=Coloradotechrescue@gmail.com
GMAIL_APP_PASSWORD=ctwhkjdheumtplxj

# Comma-separated list of origins allowed to call this API (your live site + local dev)
ALLOWED_ORIGINS=http://localhost:5173,https://coloradotechrescue.com
